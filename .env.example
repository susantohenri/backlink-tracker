# Frontend Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Set to true for in-memory mock testing mode
VITE_USE_MOCK=false

# Automation Service URL (Frontend)
VITE_AUTOMATION_SERVER_URL=http://localhost:3001

# Automation Server Configuration (Backend)
AUTOMATION_PORT=3001

# Submission & Login Credentials for Automation
DEFAULT_SUBMISSION_EMAIL=your_email@example.com
DEFAULT_SUBMISSION_PASSWORD=your_password_here
